DATABASE_URL=postgresql://sampark:sampark_local_only@localhost:5439/sampark
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
APP_MODE=development
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=local_sampark
S3_SECRET_KEY=local_sampark_change_me
S3_PRIVATE_BUCKET=sampark-private
S3_PUBLIC_BUCKET=sampark-public
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# 32 random bytes, base64 (openssl rand -base64 32). Never reuse across environments.
FIELD_ENCRYPTION_KEY=
# Optional. Self-hosted map tiles for the institutions map, served from this
# site (the CSP allows same-origin images only), e.g. /tiles/{z}/{x}/{y}.png.
# Leave empty to show the coordinate grid instead. Set the attribution your
# tile data's licence requires (OpenStreetMap-derived tiles need one).
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
# Email confirmation for registrations, and emailing DDG/ADG set-password
# links. Optional and off by default: requests go straight to the approving
# officer and the admin is shown the set-password link to hand over in
# person. Set to true only once real mail delivery is authorized.
REQUIRE_EMAIL_VERIFICATION=
# Authenticator apps (TOTP) are optional unless this is true. When true,
# officer accounts and, in production, every reviewing role must set one up.
# Add an authenticator reset for approvers before turning it on, or an
# officer who loses their phone and backup codes is locked out.
REQUIRE_TWO_FACTOR=
# Outgoing mail (verification emails). The worker delivers queued mail only
# when MAIL_DELIVERY=smtp. Development uses Mailpit (npm run db:up):
#   MAIL_DELIVERY=smtp  SMTP_URL=smtp://127.0.0.1:1025  MAIL_FROM=...
# Production delivery is a communication and needs explicit authorization;
# leave MAIL_DELIVERY unset until then (mail stays queued, then expires).
MAIL_DELIVERY=
SMTP_URL=
MAIL_FROM="Sampark <no-reply@sampark.invalid>"
